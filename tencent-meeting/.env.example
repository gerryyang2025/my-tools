TENCENT_MEETING_SECRET_ID=<your_secret_id>
TENCENT_MEETING_SECRET_KEY=<your_secret_key>
TENCENT_MEETING_OPERATOR_ID=<your_operator_id>
TENCENT_MEETING_APP_ID=
TENCENT_MEETING_SDK_ID=

